; Engine configuration file.
config_version=5

[application]

config/name="The NPC Job"
config/description="2D top-down fantasy puzzle-comedy. Guide an incompetent hero with light."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=960
window/size/viewport_height=544
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom_font="res://assets/fonts/kenney_mini_square.ttf"

[rendering]

textures/canvas_textures/default_texture_filter=0

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.05, 0.04, 0.08, 1)
